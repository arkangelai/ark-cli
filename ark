      --label=*)      label="${1#--label=}" ;;
      --label)        shift; label="$1" ;;
      --local-path=*) local_path="${1#--local-path=}" ;;
      --local-path)   shift; local_path="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
