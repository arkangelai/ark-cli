# ─── knowledge files url (download) ────────────────────────────────────────────
cmd_knowledge_files_url() {
  local path="${1:-}" name="${2:-}"; shift 2 || true
  [[ -z "$path" || -z "$name" ]] && { err_json "bad_argument" "path and name are required" "false" "{}" "ark knowledge files url <path> <name> [--task-type=audit|hospital_devolucion] [--output=<local-path>]"; exit 2; }

  local output_path="" task_type="audit"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output=*)    output_path="${1#--output=}" ;;
      --output)      shift; output_path="$1" ;;
      --task-type=*) task_type="${1#--task-type=}" ;;
      --task-type)   shift; task_type="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done
  [[ -z "$output_path" ]] && output_path="./${name}"

  case "$task_type" in
    audit|hospital_devolucion) ;;
    hospital_preventiva) err_json "bad_argument" "hospital_preventiva: knowledge no disponible (stub)" "false" "{}" ""; exit 2 ;;
    *) err_json "bad_argument" "Unknown task_type: ${task_type}" "false" "{}" "ark knowledge files url <path> <name> [--task-type=audit|hospital_devolucion]"; exit 2 ;;
  esac

  if [[ "$DRY_RUN" == "true" ]]; then
    case "$task_type" in
      audit)               dry_run_response "GET" "/api/audit/knowledge/files/url?path=${path}&name=${name}" ;;
      hospital_devolucion) dry_run_response "GET" "/api/hospitales/devolucion/knowledge/files (search ${path}/${name})" ;;
    esac
    return
  fi

  local signed_url="" expires_at="" storage_path=""
  case "$task_type" in
    audit)
      local encoded_path encoded_name
      encoded_path=$(printf '%s' "$path" | jq -sRr @uri)
      encoded_name=$(printf '%s' "$name" | jq -sRr @uri)
      http_request "GET" "/api/audit/knowledge/files/url?path=${encoded_path}&name=${encoded_name}"
      [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"
      signed_url=$(printf '%s' "$HTTP_BODY" | jq -r '.data.url // empty')
      expires_at=$(printf '%s' "$HTTP_BODY" | jq -r '.data.expires_at // empty')
      storage_path=$(printf '%s' "$HTTP_BODY" | jq -r '.data.path // empty')
      ;;
    hospital_devolucion)
      http_request "GET" "/api/hospitales/devolucion/knowledge/files"
      [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"
      signed_url=$(printf '%s' "$HTTP_BODY" | jq -r --arg fp "${path}/${name}" '
        .data | to_entries[] | .value |
        if type == "array" then .[]
        else to_entries[] | .value[] end |
        select(.path == $fp) | .url // empty' | head -1)
      storage_path="${path}/${name}"
      ;;
  esac

  [[ -z "$signed_url" ]] && { err_json "storage_error" "No signed URL returned for ${path}/${name}" "false" "{}" ""; exit 1; }

  local dl_exit=0
  set +e
  curl --silent --show-error --location --output "$output_path" "$signed_url"
  dl_exit=$?
  set -e

  if [[ $dl_exit -ne 0 ]]; then
    err_json "network_error" "Download failed (curl exit ${dl_exit})" "true" "{}" ""
    exit 1
  fi

  local size_bytes; size_bytes=$(file_size_bytes "$output_path" 2>/dev/null || echo 0)
  local local_path; local_path=$(abs_path "$output_path")

  if [[ "${ARK_FORMAT:-json}" == "human" || "$HUMAN_OUTPUT" == "true" ]]; then
    printf 'Downloaded: %s (%s bytes)\n' "$local_path" "$size_bytes"
    return
  fi

  ok_response "$(jq -n \
    --arg url "$signed_url" --arg exp "$expires_at" \
    --arg sp "$storage_path" --arg lp "$local_path" \
    --argjson sz "$size_bytes" \
    '{url:$url,expires_at:$exp,path:$sp,local_path:$lp,size_bytes:$sz}')" "{}" "{}"
}

# ─── knowledge upload ───────────────────────────────────────────────────────────
cmd_knowledge_upload() {
  local file_path="${1:-}"; shift || true
  [[ -z "$file_path" ]] && { err_json "bad_argument" "File path required" "false" "{}" "ark knowledge upload <file> --folder <folder>"; exit 2; }
  [[ -f "$file_path" ]] || { err_json "bad_argument" "File not found: ${file_path}" "false" "{}" ""; exit 2; }

  local folder="" subfolder="" desc=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --folder=*)      folder="${1#--folder=}" ;;
      --folder)        shift; folder="$1" ;;
      --subfolder=*)   subfolder="${1#--subfolder=}" ;;
      --subfolder)     shift; subfolder="$1" ;;
      --description=*) desc="${1#--description=}" ;;
      --description)   shift; desc="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done
  [[ -z "$folder" ]] && { err_json "bad_argument" "--folder is required (administrativo|medico|financiero|plantillas)" "false" "{}" "ark knowledge upload ${file_path} --folder <folder>"; exit 2; }

  local size_bytes; size_bytes=$(file_size_bytes "$file_path")
  if [[ -n "$size_bytes" && "$size_bytes" -gt "$ARK_MAX_UPLOAD_BYTES" ]]; then
    err_json "payload_too_large" "File exceeds $(upload_limit_mb)MB upload limit" "false" \
      "$(jq -n --argjson sz "$size_bytes" --argjson max "$ARK_MAX_UPLOAD_BYTES" '{size_bytes:$sz,max_bytes:$max}')" ""
    exit 2
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    local body
    body=$(jq -n --arg f "$file_path" --arg fo "$folder" --arg sf "$subfolder" --arg d "$desc" \
      '{multipart:{file:("@"+$f),folder:$fo,subfolder:$sf,description:$d}}')
    dry_run_response "POST" "/api/audit/knowledge/upload" "$body"
    return
  fi

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"
  local fields=("file=@${file_path}" "folder=${folder}")
  [[ -n "$subfolder" ]] && fields+=("subfolder=${subfolder}")
  [[ -n "$desc" ]]      && fields+=("description=${desc}")

  http_upload "POST" "/api/audit/knowledge/upload" "$ikey" "${fields[@]}"
  [[ "$HTTP_STATUS" == "200" || "$HTTP_STATUS" == "201" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data; data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')
  ok_response "$data" "{}" "{}"
}

