  [[ -z "$id" ]] && { err_json "bad_argument" "Task ID required" "false" "{}" "ark tasks inputs add <id> --path <path>"; exit 2; }

  local path="" path_type="" desc=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --path=*)        path="${1#--path=}" ;;
      --path)          shift; path="$1" ;;
      --type=*)        path_type="${1#--type=}" ;;
      --type)          shift; path_type="$1" ;;
      --description=*) desc="${1#--description=}" ;;
      --description)   shift; desc="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done
  [[ -z "$path" ]] && { err_json "bad_argument" "--path is required" "false" "{}" "ark tasks inputs add ${id} --path <path>"; exit 2; }

  local body
  body=$(jq -n --arg p "$path" --arg t "$path_type" --arg d "$desc" \
    '{path:$p}
     + (if $t != "" then {path_type:$t} else {} end)
     + (if $d != "" then {description:$d} else {} end)')

  [[ "$DRY_RUN" == "true" ]] && { dry_run_response "POST" "/api/tasks/${id}/inputs" "$body"; return; }

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"
  http_request "POST" "/api/tasks/${id}/inputs" "$body" "$ikey"
  [[ "$HTTP_STATUS" == "200" || "$HTTP_STATUS" == "201" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

