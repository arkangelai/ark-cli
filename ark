#!/usr/bin/env bash
set -euo pipefail

ARK_VERSION="0.5.0"
ARK_CONFIG_FILE="${ARK_CONFIG_FILE:-${HOME}/.config/ark/config}"
ARK_DEFAULT_API_URL="https://audit.arkangel.ai"
ARK_DEFAULT_LIMIT="20"
HUMAN_OUTPUT="${HUMAN_OUTPUT:-false}"
DRY_RUN=false
KNOWN_TASK_FIELDS="id title description status priority task_type context deadline_at log_path confidence_score version created_by created_by_type created_at updated_at"
BRIEF_TASK_FIELDS="id,status,title,created_at"

# ─── Dependencies ──────────────────────────────────────────────────────────────
check_deps() {
  local missing=()
  for cmd in curl jq; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    local hint
    if [[ "$(uname)" == "Darwin" ]]; then
      hint="brew install ${missing[*]}"
    else
      hint="sudo apt-get install -y ${missing[*]}"
    fi
    printf '{"ok":false,"cli_version":"%s","error":{"code":"missing_dependency","message":"Required: %s","retryable":false,"detail":{}},"suggestion":"%s"}\n' \
      "$ARK_VERSION" "${missing[*]}" "$hint" >&2
    exit 1
  fi
}

# ─── UUID ──────────────────────────────────────────────────────────────────────
gen_uuid() {
  if command -v uuidgen &>/dev/null; then
    uuidgen | tr '[:upper:]' '[:lower:]'
  elif [[ -f /proc/sys/kernel/random/uuid ]]; then
    cat /proc/sys/kernel/random/uuid
  else
    python3 -c 'import uuid; print(uuid.uuid4())'
  fi
}

# ─── Config ────────────────────────────────────────────────────────────────────
config_get() {
  [[ -f "$ARK_CONFIG_FILE" ]] && grep "^${1}=" "$ARK_CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true
}

config_set() {
  mkdir -p "$(dirname "$ARK_CONFIG_FILE")"
  touch "$ARK_CONFIG_FILE" && chmod 600 "$ARK_CONFIG_FILE"
  local tmp; tmp=$(mktemp)
  grep -v "^${1}=" "$ARK_CONFIG_FILE" > "$tmp" 2>/dev/null || true
  echo "${1}=${2}" >> "$tmp"
  mv "$tmp" "$ARK_CONFIG_FILE" && chmod 600 "$ARK_CONFIG_FILE"
}

config_display_value() {
  local key="$1" value="$2"
  if [[ "$key" == "api-key" && -n "$value" ]]; then
    if [[ ${#value} -le 4 ]]; then
      printf '%s' '***'
    else
      printf '%s***' "${value:0:4}"
    fi
  else
    printf '%s' "$value"
  fi
}

config_del() {
  if [[ -f "$ARK_CONFIG_FILE" ]]; then
    local tmp; tmp=$(mktemp)
    grep -v "^${1}=" "$ARK_CONFIG_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$ARK_CONFIG_FILE" && chmod 600 "$ARK_CONFIG_FILE"
  fi
}

# ─── API key + URL ─────────────────────────────────────────────────────────────
resolve_api_key() {
  local k
  k=$(config_get "api-key")
  if [[ -z "$k" ]]; then
    err_json "unauthenticated" "No API key configured. Run: ark config set api-key <your-key>" "false" "{}" "ark config set api-key <your-key>"
    exit 3
  fi
  echo "$k"
}

resolve_api_url() {
  if [[ -n "${ARK_API_URL:-}" ]]; then
    echo "$ARK_API_URL"
  else
    local stored; stored=$(config_get "url")
    echo "${stored:-$ARK_DEFAULT_API_URL}"
  fi
}

# ─── Error output ──────────────────────────────────────────────────────────────
err_json() {
  local code="$1" msg="$2" retryable="$3" detail="${4}" suggestion="${5:-}"
  [[ -z "$detail" ]] && detail="{}"
  jq -n \
    --arg v "$ARK_VERSION" --arg code "$code" --arg msg "$msg" \
    --argjson retryable "$retryable" --argjson detail "$detail" \
    --arg suggestion "$suggestion" \
    '{ok:false,cli_version:$v,error:{code:$code,message:$msg,retryable:$retryable,detail:$detail},suggestion:$suggestion}' >&2
}

# ─── HTTP ──────────────────────────────────────────────────────────────────────
HTTP_STATUS="" HTTP_BODY="" HTTP_REQUEST_ID="" HTTP_IDEMPOTENT_REPLAY="false"

http_request() {
  local method="$1" path="$2" body="${3:-}" idem_key="${4:-}"
  local token; token=$(resolve_api_key)
  local url; url="$(resolve_api_url)${path}"
  local body_file header_file
  body_file=$(mktemp); header_file=$(mktemp)

  local args=(
    --silent --write-out "%{http_code}"
    --output "$body_file" --dump-header "$header_file"
    -X "$method"
    -H "Authorization: Bearer ${token}"
    -H "Content-Type: application/json"
  )
  [[ -n "$idem_key" ]] && args+=(-H "Idempotency-Key: ${idem_key}")
  [[ -n "$body" ]] && args+=(--data "$body")

  [[ "${ARK_DEBUG:-0}" -ge 2 ]] && echo "[DEBUG] ${method} ${url}${body:+ body=${body}}" >&2

  local exit_code=0
  set +e
  HTTP_STATUS=$(curl "${args[@]}" "$url")
  exit_code=$?
  set -e

  HTTP_BODY=$(cat "$body_file")
  HTTP_REQUEST_ID=$(grep -i '^x-request-id:' "$header_file" 2>/dev/null | tr -d '\r' | awk '{print $2}' || true)
  local replay; replay=$(grep -i '^x-idempotent-replay:' "$header_file" 2>/dev/null | tr -d '\r' | awk '{print $2}' | tr '[:upper:]' '[:lower:]' || true)
  HTTP_IDEMPOTENT_REPLAY="${replay:-false}"
  [[ "$HTTP_IDEMPOTENT_REPLAY" == "true" ]] || HTTP_IDEMPOTENT_REPLAY="false"

  rm -f "$body_file" "$header_file"

  [[ "${ARK_DEBUG:-0}" -ge 1 ]] && echo "[DEBUG] status=${HTTP_STATUS} body=${HTTP_BODY}" >&2

  if [[ $exit_code -ne 0 ]]; then
    err_json "network_error" "curl failed (exit ${exit_code}): ${url}" "true" "{}" ""
    exit 1
  fi
}

# ─── Response builder ──────────────────────────────────────────────────────────
ok_response() {
  local _empty_obj="{}"
  local data="$1" links="${2:-$_empty_obj}" cmds="${3:-$_empty_obj}" meta="${4:-}"
  local replay="${HTTP_IDEMPOTENT_REPLAY:-false}"
  local rid="${HTTP_REQUEST_ID:-}"
  local base
  base=$(printf '%s' "$data" | jq -n \
    --arg v "$ARK_VERSION" \
    --argjson links "$links" --argjson cmds "$cmds" \
    --argjson replay "$replay" --arg rid "$rid" \
    'input as $data | {ok:true,cli_version:$v,data:$data,"_links":$links,next_commands:$cmds,idempotent_replay:$replay,request_id:$rid}')
  [[ -n "$meta" ]] && base=$(printf '%s' "$base" | jq --argjson m "$meta" '. + {meta:$m}')
  echo "$base"
}

# ─── HTTP error handler ────────────────────────────────────────────────────────
handle_http_error() {
  local status="$1" body="$2"
  local code msg detail retryable suggestion exit_code

  if printf '%s' "$body" | jq -e '.error' &>/dev/null 2>&1; then
    code=$(printf '%s' "$body" | jq -r '.error.code // "unknown_error"')
    msg=$(printf '%s' "$body" | jq -r '.error.message // "Unknown error"')
    detail=$(printf '%s' "$body" | jq -c '.error.detail // {}')
  else
    code="unknown_error"; msg="HTTP ${status}"; detail="{}"
  fi

  case "$status" in
    401|403) retryable="false"; exit_code=3; suggestion="Run: ark config set api-key <your-key>" ;;
    404)     retryable="false"; exit_code=4; suggestion="" ;;
    409|422) retryable="false"; exit_code=5
      if [[ "$code" == "invalid_status_transition" ]]; then
        local allowed; allowed=$(printf '%s' "$body" | jq -r '.error.detail.allowed // [] | join(", ")')
        suggestion="Allowed transitions: ${allowed}"
      else
        suggestion=""
      fi ;;
    429) retryable="true"; exit_code=29; suggestion="Set ARK_IDEMPOTENCY_KEY and retry after delay" ;;
    *)   retryable="true"; exit_code=1; suggestion="" ;;
  esac

  jq -n \
    --arg v "$ARK_VERSION" --arg code "$code" --arg msg "$msg" \
    --argjson retryable "$retryable" --argjson detail "$detail" \
    --arg suggestion "$suggestion" --arg rid "${HTTP_REQUEST_ID:-}" \
    '{ok:false,cli_version:$v,error:{code:$code,message:$msg,retryable:$retryable,detail:$detail},suggestion:$suggestion,request_id:$rid}' >&2
  exit "$exit_code"
}

check_status() {
  [[ "$HTTP_STATUS" == "$1" || "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"
}

# ─── HTTP multipart (uploads) ──────────────────────────────────────────────────
# Usage: http_upload METHOD PATH IDEM_KEY -- -F field=value -F file=@path ...
# Curl sets Content-Type: multipart/form-data with the boundary itself.
http_upload() {
  local method="$1" path="$2" idem_key="${3:-}"; shift 3
  local token; token=$(resolve_api_key)
  local url; url="$(resolve_api_url)${path}"
  local body_file header_file
  body_file=$(mktemp); header_file=$(mktemp)

  local args=(
    --silent --write-out "%{http_code}"
    --output "$body_file" --dump-header "$header_file"
    -X "$method"
    -H "Authorization: Bearer ${token}"
  )
  [[ -n "$idem_key" ]] && args+=(-H "Idempotency-Key: ${idem_key}")
  while [[ $# -gt 0 ]]; do args+=(-F "$1"); shift; done

  [[ "${ARK_DEBUG:-0}" -ge 2 ]] && echo "[DEBUG] ${method} ${url} (multipart)" >&2

  local exit_code=0
  set +e
  HTTP_STATUS=$(curl "${args[@]}" "$url")
  exit_code=$?
  set -e

  HTTP_BODY=$(cat "$body_file")
  HTTP_REQUEST_ID=$(grep -i '^x-request-id:' "$header_file" 2>/dev/null | tr -d '\r' | awk '{print $2}' || true)
  local replay; replay=$(grep -i '^x-idempotent-replay:' "$header_file" 2>/dev/null | tr -d '\r' | awk '{print $2}' | tr '[:upper:]' '[:lower:]' || true)
  HTTP_IDEMPOTENT_REPLAY="${replay:-false}"
  [[ "$HTTP_IDEMPOTENT_REPLAY" == "true" ]] || HTTP_IDEMPOTENT_REPLAY="false"

  rm -f "$body_file" "$header_file"

  [[ "${ARK_DEBUG:-0}" -ge 1 ]] && echo "[DEBUG] status=${HTTP_STATUS} body=${HTTP_BODY}" >&2

  if [[ $exit_code -ne 0 ]]; then
    err_json "network_error" "curl failed (exit ${exit_code}): ${url}" "true" "{}" ""
    exit 1
  fi
}

# ─── upload helpers ────────────────────────────────────────────────────────────
ARK_MAX_UPLOAD_BYTES="${ARK_MAX_UPLOAD_BYTES:-$((500 * 1024 * 1024))}"
ARK_UPLOAD_RETRY_ATTEMPTS="${ARK_UPLOAD_RETRY_ATTEMPTS:-3}"

upload_limit_mb() {
  echo $((ARK_MAX_UPLOAD_BYTES / 1024 / 1024))
}

file_size_bytes() {
  stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null
}

abs_path() {
  local p="$1"
  if [[ "$p" == /* ]]; then echo "$p"
  else echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  fi
}

file_basename() {
  basename "$1"
}

is_ignored_bulk_file() {
  local rel="$1" base="$2"
  [[ "$base" == ".DS_Store" || "$base" == "Thumbs.db" ]] && return 0
  [[ "$base" == .* ]] && return 0
  [[ "$rel" == .* || "$rel" == */.* ]] && return 0
  return 1
}

matches_any_glob_file() {
  local rel="$1" base="$2" glob_file="$3"
  [[ -f "$glob_file" ]] || return 1

  local pattern
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    if [[ "$rel" == $pattern || "$base" == $pattern ]]; then
      return 0
    fi
  done < "$glob_file"

  return 1
}

curl_put_signed_file() {
  local file_path="$1" signed_url="$2" attempts="${3:-$ARK_UPLOAD_RETRY_ATTEMPTS}"
  local attempt=1 status body_file

  while (( attempt <= attempts )); do
    body_file=$(mktemp)
    local curl_exit=0
    set +e
    status=$(curl --silent --show-error --location \
      --write-out "%{http_code}" \
      --output "$body_file" \
      -X PUT \
      -H "Content-Type: application/octet-stream" \
      --upload-file "$file_path" \
      "$signed_url")
    curl_exit=$?
    set -e

    if [[ $curl_exit -eq 0 && "$status" =~ ^2 ]]; then
      rm -f "$body_file"
      return 0
    fi

    local body; body=$(cat "$body_file" 2>/dev/null || true)
    if [[ "$body" =~ [Aa]lready.exists || "$body" =~ [Dd]uplicate ]]; then
      rm -f "$body_file"
      return 0
    fi

    if (( attempt == attempts )); then
      rm -f "$body_file"
      printf 'PUT failed for %s (curl=%s http=%s) %s\n' "$file_path" "$curl_exit" "$status" "$body" >&2
      return 1
    fi

    rm -f "$body_file"
    sleep $((2 ** (attempt - 1)))
    attempt=$((attempt + 1))
  done
}

# ─── next_commands builder ─────────────────────────────────────────────────────
next_cmds() {
  local id="$1" links="$2"
  local out="{}"
  while IFS= read -r key; do
    [[ -z "$key" ]] && continue
    local cmd
    case "$key" in
      claim)           cmd="ark tasks claim ${id}" ;;
      ask_review|ask-review) cmd="ark tasks ask-review ${id} --reason \"<reason>\"" ;;
      complete)        cmd="ark tasks complete ${id} --confidence <0.0-1.0>" ;;
      block)           cmd="ark tasks block ${id} --reason \"<reason>\"" ;;
      set_workspace)   cmd="ark tasks update ${id} --log-path \"<storage-path>\"" ;;
      add_output)      cmd="ark tasks outputs submit ${id} --type <type> --label <label>" ;;
      upload_output)   cmd="ark tasks outputs upload ${id} <file-path> --type <type> --label <label>" ;;
      upload_input)    cmd="ark tasks inputs upload ${id} <file-path>" ;;
      document_url)    cmd="ark tasks documents url ${id} <input|output> <record-id>" ;;
      post_note)       cmd="ark tasks comments post ${id} --label note --body \"<body>\"" ;;
      register_input)  cmd="ark tasks inputs add ${id} --path \"<path>\"" ;;
      approve)         cmd="ark tasks status ${id} --status done" ;;
      request_changes) cmd="ark tasks status ${id} --status queued --comment-id <comment-id>" ;;
      queue|requeue)   cmd="ark tasks status ${id} --status queued" ;;
      cancel)          cmd="ark tasks status ${id} --status cancelled" ;;
      archive)         cmd="ark tasks status ${id} --status archived" ;;
      comment)         cmd="ark tasks comments post ${id} --label comment --body \"<body>\"" ;;
      self)            cmd="ark tasks get ${id}" ;;
      *)               cmd="ark tasks get ${id}" ;;
    esac
    out=$(printf '%s' "$out" | jq --arg k "$key" --arg v "$cmd" '. + {($k): $v}')
  done < <(printf '%s' "$links" | jq -r 'keys[]' 2>/dev/null || true)
  echo "$out"
}

# ─── dry-run helper ────────────────────────────────────────────────────────────
dry_run_response() {
  local method="$1" path="$2" body="${3:-}"
  printf '%s' "${body:-null}" | jq -n --arg v "$ARK_VERSION" --arg m "$method" --arg p "$path" \
    'input as $body | {ok:true,cli_version:$v,dry_run:true,data:{would_send:{method:$m,path:$p,body:$body}}}'
}

url_encode() {
  printf '%s' "$1" | jq -sRr @uri
}

append_query_param() {
  local query="$1" key="$2" value="$3"
  local encoded; encoded=$(url_encode "$value")
  if [[ -n "$query" ]]; then
    printf '%s&%s=%s' "$query" "$key" "$encoded"
  else
    printf '%s=%s' "$key" "$encoded"
  fi
}

# Resolve a task document's signed URL and stream it to stdout or atomically
# replace the requested output file. The metadata argument is included only in
# file-mode responses; stdout must remain raw so callers can pipe it directly.
download_task_document() {
  local task_id="$1" kind="$2" record_id="$3" output_path="$4" metadata="$5"
  local encoded_task_id encoded_record_id
  encoded_task_id=$(url_encode "$task_id")
  encoded_record_id=$(url_encode "$record_id")

  http_request "GET" "/api/tasks/${encoded_task_id}/documents/${kind}/${encoded_record_id}/url"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local signed_url expires_at storage_path
  signed_url=$(printf '%s' "$HTTP_BODY" | jq -r '.data.url // empty')
  expires_at=$(printf '%s' "$HTTP_BODY" | jq -r '.data.expires_at // empty')
  storage_path=$(printf '%s' "$HTTP_BODY" | jq -r '.data.storage_path // .data.path // empty')

  [[ -n "$signed_url" ]] || {
    err_json "storage_error" "No signed URL returned for ${kind} ${record_id}" "false" \
      "$(jq -n --arg task_id "$task_id" --arg kind "$kind" --arg record_id "$record_id" \
        '{task_id:$task_id,kind:$kind,record_id:$record_id}')" ""
    exit 1
  }

  local curl_exit=0
  if [[ -z "$output_path" ]]; then
    set +e
    curl --fail --silent --location "$signed_url"
    curl_exit=$?
    set -e
  else
    local output_dir temp_path
    [[ ! -d "$output_path" ]] || {
      err_json "bad_argument" "Output path is a directory: ${output_path}" "false" "{}" ""
      exit 2
    }
    output_dir=$(dirname "$output_path")
    [[ -d "$output_dir" ]] || {
      err_json "bad_argument" "Output directory does not exist: ${output_dir}" "false" "{}" ""
      exit 2
    }
    temp_path=$(mktemp "${output_path}.tmp.XXXXXX") || {
      err_json "write_error" "Could not create a temporary file for: ${output_path}" "false" "{}" ""
      exit 1
    }
    set +e
    curl --fail --silent --location --output "$temp_path" "$signed_url"
    curl_exit=$?
    set -e
    if [[ $curl_exit -eq 0 ]]; then
      if ! mv "$temp_path" "$output_path" 2>/dev/null; then
        rm -f "$temp_path"
        err_json "write_error" "Could not replace output file: ${output_path}" "false" "{}" ""
        exit 1
      fi
    else
      rm -f "$temp_path"
    fi
  fi

  if [[ $curl_exit -ne 0 ]]; then
    err_json "network_error" "Download failed (curl exit ${curl_exit})" "true" \
      "$(jq -n --arg task_id "$task_id" --arg kind "$kind" --arg record_id "$record_id" \
        '{task_id:$task_id,kind:$kind,record_id:$record_id}')" "Retry to request a fresh signed URL"
    exit 1
  fi

  [[ -z "$output_path" ]] && return

  local size_bytes local_path
  size_bytes=$(file_size_bytes "$output_path" 2>/dev/null || echo 0)
  local_path=$(abs_path "$output_path")
  ok_response "$(printf '%s' "$metadata" | jq \
    --arg url "$signed_url" --arg exp "$expires_at" --arg sp "$storage_path" \
    --arg lp "$local_path" --argjson sz "${size_bytes:-0}" \
    '. + {url:$url,expires_at:$exp,storage_path:$sp,local_path:$lp,size_bytes:$sz}')" "{}" "{}"
}

# ─── auth ──────────────────────────────────────────────────────────────────────
cmd_auth() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    status)
      local key; key=$(config_get "api-key") || true
      if [[ -z "$key" ]]; then
        jq -n --arg v "$ARK_VERSION" '{ok:true,cli_version:$v,data:{authenticated:false,api_key:null}}'
        return
      fi

      local masked="${key:0:4}***"
      local api_url; api_url=$(resolve_api_url)
      local resp_file header_file; resp_file=$(mktemp); header_file=$(mktemp)
      local http_status curl_exit=0

      set +e
      http_status=$(curl --silent --write-out "%{http_code}" \
        --output "$resp_file" --dump-header "$header_file" \
        -H "Authorization: Bearer ${key}" \
        "${api_url}/api/tasks?limit=1")
      curl_exit=$?
      set -e

      rm -f "$resp_file" "$header_file"

      if [[ $curl_exit -ne 0 ]]; then
        err_json "network_error" "curl failed (exit ${curl_exit})" "true" "{}" ""; exit 1
      fi

      if [[ "$http_status" == "200" ]]; then
        jq -n --arg v "$ARK_VERSION" --arg k "$masked" \
          '{ok:true,cli_version:$v,data:{authenticated:true,api_key:$k}}'
      else
        jq -n --arg v "$ARK_VERSION" --arg k "$masked" --arg s "$http_status" \
          '{ok:true,cli_version:$v,data:{authenticated:false,api_key:$k,error:"invalid_key",http_status:$s}}'
      fi
      ;;
    *) err_json "bad_argument" "Unknown auth subcommand: ${sub}. Use: status" "false" "{}" "ark auth status"; exit 2 ;;
  esac
}

# ─── config ────────────────────────────────────────────────────────────────────
cmd_config() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    set)
      local key="${1:-}" value="${2:-}"
      [[ -z "$key" || -z "$value" ]] && {
        err_json "bad_argument" "Usage: ark config set <key> <value>" "false" "{}" "ark config set url <url>"
        exit 2
      }
      config_set "$key" "$value"
      local display_value; display_value=$(config_display_value "$key" "$value")
      jq -n --arg v "$ARK_VERSION" --arg k "$key" --arg val "$display_value" \
        '{ok:true,cli_version:$v,data:{key:$k,value:$val}}'
      ;;
    get)
      local key="${1:-}"
      [[ -z "$key" ]] && {
        err_json "bad_argument" "Usage: ark config get <key>" "false" "{}" "ark config get url"
        exit 2
      }
      local val; val=$(config_get "$key")
      jq -n --arg v "$ARK_VERSION" --arg k "$key" --arg val "$val" \
        '{ok:true,cli_version:$v,data:{key:$k,value:$val}}'
      ;;
    list)
      local url; url=$(config_get "url")
      local raw_key; raw_key=$(config_get "api-key")
      local masked_key; masked_key=$(config_display_value "api-key" "$raw_key")
      jq -n --arg v "$ARK_VERSION" \
        --arg url "${url:-}" \
        --arg key "${masked_key}" \
        '{ok:true,cli_version:$v,data:{url:$url,"api-key":$key}}'
      ;;
    *) err_json "bad_argument" "Unknown config subcommand: ${sub}. Use: set, get, list" "false" "{}" ""; exit 2 ;;
  esac
}

# ─── tasks list ────────────────────────────────────────────────────────────────
require_option_value() {
  local option="$1" value="$2"
  [[ -n "$value" ]] || {
    err_json "bad_argument" "${option} requires a value" "false" "{}" ""
    exit 2
  }
}

validate_task_fields() {
  local fields="$1" field
  local selected_fields=()

  [[ -n "$fields" ]] || {
    err_json "bad_argument" "--fields requires a comma-separated field list" "false" "{}" \
      "Example: ark tasks list --fields id,status,title,created_at"
    exit 2
  }

  IFS=',' read -r -a selected_fields <<< "$fields"
  for field in "${selected_fields[@]}"; do
    if [[ -z "$field" || ! "$field" =~ ^[a-z][a-z0-9_]*$ ]]; then
      err_json "bad_argument" "Invalid task field: ${field:-<empty>}" "false" \
        "$(jq -cn --arg field "$field" '{received:$field,format:"lowercase snake_case"}')" \
        "Use a comma-separated list such as id,status,title,created_at"
      exit 2
    fi
  done
  if [[ "$fields" == *, ]]; then
    err_json "bad_argument" "Invalid task field: <empty>" "false" \
      "$(jq -cn '{received:"",format:"lowercase snake_case"}')" \
      "Remove the trailing comma from --fields"
    exit 2
  fi
}

cmd_tasks_list() {
  local status_f="" priority_f="" limit="$ARK_DEFAULT_LIMIT" cursor="" fetch_all="false"
  local created_after="" created_before="" sort_f="" order_f="" fields_f=""
  local task_type="" created_by_type="" factura_key="" client_ref=""
  local batch_id="" parent_task_id="" option_name=""
  local brief="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status=*)   status_f="${1#--status=}" ;;
      --status)     [[ $# -ge 2 ]] || { err_json "bad_argument" "--status requires a value" "false" "{}" ""; exit 2; }; shift; status_f="$1" ;;
      --priority=*) priority_f="${1#--priority=}" ;;
      --priority)   [[ $# -ge 2 ]] || { err_json "bad_argument" "--priority requires a value" "false" "{}" ""; exit 2; }; shift; priority_f="$1" ;;
      --type=*|--task-type=*) task_type="${1#*=}"; require_option_value "${1%%=*}" "$task_type" ;;
      --type|--task-type) option_name="$1"; [[ $# -ge 2 ]] || require_option_value "$option_name" ""; shift; task_type="$1"; require_option_value "$option_name" "$task_type" ;;
      --created-by-type=*) created_by_type="${1#--created-by-type=}"; require_option_value "--created-by-type" "$created_by_type" ;;
      --created-by-type) [[ $# -ge 2 ]] || require_option_value "--created-by-type" ""; shift; created_by_type="$1"; require_option_value "--created-by-type" "$created_by_type" ;;
      --factura-key=*) factura_key="${1#--factura-key=}"; require_option_value "--factura-key" "$factura_key" ;;
      --factura-key) [[ $# -ge 2 ]] || require_option_value "--factura-key" ""; shift; factura_key="$1"; require_option_value "--factura-key" "$factura_key" ;;
      --client-ref=*) client_ref="${1#--client-ref=}"; require_option_value "--client-ref" "$client_ref" ;;
      --client-ref) [[ $# -ge 2 ]] || require_option_value "--client-ref" ""; shift; client_ref="$1"; require_option_value "--client-ref" "$client_ref" ;;
      --batch-id=*) batch_id="${1#--batch-id=}"; require_option_value "--batch-id" "$batch_id" ;;
      --batch-id) [[ $# -ge 2 ]] || require_option_value "--batch-id" ""; shift; batch_id="$1"; require_option_value "--batch-id" "$batch_id" ;;
      --parent=*|--parent-task-id=*) parent_task_id="${1#*=}"; require_option_value "${1%%=*}" "$parent_task_id" ;;
      --parent|--parent-task-id) option_name="$1"; [[ $# -ge 2 ]] || require_option_value "$option_name" ""; shift; parent_task_id="$1"; require_option_value "$option_name" "$parent_task_id" ;;
      --limit=*)    limit="${1#--limit=}" ;;
      --limit)      [[ $# -ge 2 ]] || { err_json "bad_argument" "--limit requires a value" "false" "{}" ""; exit 2; }; shift; limit="$1" ;;
      --cursor=*)   cursor="${1#--cursor=}" ;;
      --cursor)     [[ $# -ge 2 ]] || { err_json "bad_argument" "--cursor requires a value" "false" "{}" ""; exit 2; }; shift; cursor="$1" ;;
      --since=*)    created_after="${1#--since=}"; require_option_value "--since" "$created_after" ;;
      --since)      [[ $# -ge 2 ]] || require_option_value "--since" ""; shift; created_after="$1"; require_option_value "--since" "$created_after" ;;
      --until=*)    created_before="${1#--until=}"; require_option_value "--until" "$created_before" ;;
      --until)      [[ $# -ge 2 ]] || require_option_value "--until" ""; shift; created_before="$1"; require_option_value "--until" "$created_before" ;;
      --sort=*)     sort_f="${1#--sort=}"; require_option_value "--sort" "$sort_f" ;;
      --sort)       [[ $# -ge 2 ]] || require_option_value "--sort" ""; shift; sort_f="$1"; require_option_value "--sort" "$sort_f" ;;
      --order=*)    order_f="${1#--order=}"; require_option_value "--order" "$order_f" ;;
      --order)      [[ $# -ge 2 ]] || require_option_value "--order" ""; shift; order_f="$1"; require_option_value "--order" "$order_f" ;;
      --fields=*)   fields_f="${1#--fields=}"; require_option_value "--fields" "$fields_f" ;;
      --fields)     [[ $# -ge 2 ]] || require_option_value "--fields" ""; shift; fields_f="$1"; require_option_value "--fields" "$fields_f" ;;
      --brief)      brief="true" ;;
      --all)        fetch_all="true"; limit=100 ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done

  if [[ -n "$order_f" && "$order_f" != "asc" && "$order_f" != "desc" ]]; then
    err_json "bad_argument" "--order must be asc or desc" "false" \
      "$(jq -cn --arg order "$order_f" '{received:$order,allowed:["asc","desc"]}')" \
      "Use --order asc or --order desc"
    exit 2
  fi
  if [[ "$brief" == "true" && -n "$fields_f" ]]; then
    err_json "bad_argument" "--brief and --fields cannot be used together" "false" "{}" \
      "Use --brief or provide an explicit --fields list"
    exit 2
  fi
  [[ "$brief" == "true" ]] && fields_f="$BRIEF_TASK_FIELDS"
  [[ -n "$fields_f" ]] && validate_task_fields "$fields_f"

  local data="[]" meta="{}" page_cursor="$cursor" total_count=0
  while true; do
    local q=""
    q=$(append_query_param "$q" "limit" "$limit")
    [[ -n "$status_f" ]]       && q=$(append_query_param "$q" "status" "$status_f")
    [[ -n "$priority_f" ]]     && q=$(append_query_param "$q" "priority" "$priority_f")
    [[ -n "$task_type" ]]      && q=$(append_query_param "$q" "task_type" "$task_type")
    [[ -n "$created_by_type" ]] && q=$(append_query_param "$q" "created_by_type" "$created_by_type")
    [[ -n "$factura_key" ]]    && q=$(append_query_param "$q" "factura_key" "$factura_key")
    [[ -n "$client_ref" ]]     && q=$(append_query_param "$q" "client_ref" "$client_ref")
    [[ -n "$batch_id" ]]       && q=$(append_query_param "$q" "batch_id" "$batch_id")
    [[ -n "$parent_task_id" ]] && q=$(append_query_param "$q" "parent_task_id" "$parent_task_id")
    [[ -n "$page_cursor" ]]    && q=$(append_query_param "$q" "cursor" "$page_cursor")
    [[ -n "$created_after" ]]  && q=$(append_query_param "$q" "created_after" "$created_after")
    [[ -n "$created_before" ]] && q=$(append_query_param "$q" "created_before" "$created_before")
    [[ -n "$sort_f" ]]         && q=$(append_query_param "$q" "sort" "$sort_f")
    [[ -n "$order_f" ]]        && q=$(append_query_param "$q" "order" "$order_f")
    [[ -n "$fields_f" ]]       && q=$(append_query_param "$q" "fields" "$fields_f")

    http_request "GET" "/api/tasks?${q}"
    [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

    local page_data page_meta
    page_data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // []')
    page_meta=$(printf '%s' "$HTTP_BODY" | jq -c '.meta // {}')

    if [[ "$fetch_all" != "true" ]]; then
      data="$page_data"
      meta="$page_meta"
      break
    fi

    data=$(printf '%s\n%s\n' "$data" "$page_data" | jq -cs '.[0] + .[1]')
    total_count=$(printf '%s' "$data" | jq 'length')

    local next_cursor
    next_cursor=$(printf '%s' "$page_meta" | jq -r '.next_cursor // empty')
    if [[ -z "$next_cursor" ]]; then
      meta=$(printf '%s' "$page_meta" | jq -c --argjson count "$total_count" \
        '. + {count:$count,next_cursor:null}')
      break
    fi
    if [[ "$next_cursor" == "$page_cursor" ]]; then
      err_json "pagination_stalled" "API returned the same next_cursor twice" "false" \
        "$(jq -n --arg cursor "$next_cursor" '{cursor:$cursor}')" \
        "Retry without --all and inspect meta.next_cursor"
      exit 1
    fi
    page_cursor="$next_cursor"
  done

  if [[ "${ARK_FORMAT:-json}" == "human" || "$HUMAN_OUTPUT" == "true" ]]; then
    printf '%s' "$data" | jq -r '.[] | "[\(.status)] \(.id) — \(.title)"'
    echo "count: $(printf '%s' "$meta" | jq -r '.count // 0')"
    return
  fi
  ok_response "$data" "{}" "{}" "$meta"
}

