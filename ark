# ─── tasks outputs download ────────────────────────────────────────────────────
cmd_tasks_outputs_download() {
  local id="${1:-}"; shift || true
  [[ -n "$id" ]] || {
    err_json "bad_argument" "Task ID required" "false" "{}" \
      "ark tasks outputs download <id> [--label report] [--version N] [-o <file>]"
    exit 2
  }

  local label="report" version="" output_path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --label=*) label="${1#--label=}" ;;
      --label) shift; [[ $# -gt 0 ]] || { err_json "bad_argument" "--label requires a value" "false" "{}" ""; exit 2; }; label="$1" ;;
      --version=*) version="${1#--version=}"; [[ -n "$version" ]] || { err_json "bad_argument" "--version requires a value" "false" "{}" ""; exit 2; } ;;
      --version) shift; [[ $# -gt 0 && -n "$1" ]] || { err_json "bad_argument" "--version requires a value" "false" "{}" ""; exit 2; }; version="$1" ;;
      -o|--output) local output_flag="$1"; shift; [[ $# -gt 0 && -n "$1" ]] || { err_json "bad_argument" "${output_flag} requires a file path" "false" "{}" ""; exit 2; }; output_path="$1" ;;
      --output=*) output_path="${1#--output=}"; [[ -n "$output_path" ]] || { err_json "bad_argument" "--output requires a file path" "false" "{}" ""; exit 2; } ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done

  [[ -n "$label" ]] || { err_json "bad_argument" "--label cannot be empty" "false" "{}" ""; exit 2; }
  if [[ -n "$version" && ( ! "$version" =~ ^[0-9]+$ || "$version" -lt 1 ) ]]; then
    err_json "bad_argument" "--version must be a positive integer" "false" "{}" ""; exit 2
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    dry_run_response "GET" "/api/tasks/${id}/outputs -> select label=${label}${version:+ version=${version}} -> signed file${output_path:+ -> ${output_path}}"
    return
  fi

  local encoded_id; encoded_id=$(url_encode "$id")
  http_request "GET" "/api/tasks/${encoded_id}/outputs"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local selected
  if [[ -n "$version" ]]; then
    selected=$(printf '%s' "$HTTP_BODY" | jq -c --arg label "$label" --arg version "$version" \
      '[.data[]? | select(.label == $label and (.version | tostring) == $version)] | last // empty')
  else
    selected=$(printf '%s' "$HTTP_BODY" | jq -c --arg label "$label" \
      '[.data[]? | select(.label == $label)] | sort_by(.version | tonumber) | last // empty')
  fi

  [[ -n "$selected" ]] || {
    local detail
    detail=$(jq -n --arg task_id "$id" --arg label "$label" --arg version "$version" \
      '{task_id:$task_id,label:$label} + (if $version != "" then {version:($version | tonumber)} else {} end)')
    err_json "not_found" "No output found for label '${label}'${version:+ and version ${version}}" "false" "$detail" \
      "ark tasks outputs list ${id}"
    exit 4
  }

  local output_id
  output_id=$(printf '%s' "$selected" | jq -r '.id // empty')
  [[ -n "$output_id" ]] || {
    err_json "invalid_response" "Selected output is missing its ID" "false" \
      "$(jq -n --arg task_id "$id" --arg label "$label" '{task_id:$task_id,label:$label}')" ""
    exit 1
  }

  local metadata
  metadata=$(printf '%s' "$selected" | jq -c --arg task_id "$id" \
    '{task_id:$task_id,kind:"output",output_id:.id,label:.label,version:.version,output_type:.output_type}')
  download_task_document "$id" "output" "$output_id" "$output_path" "$metadata"
}

# ─── tasks documents url ───────────────────────────────────────────────────────
cmd_tasks_documents_url() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    url)
      local id="${1:-}" kind="${2:-}" record_id="${3:-}"
      [[ -z "$id" || -z "$kind" || -z "$record_id" ]] && {
        err_json "bad_argument" "Task ID, kind (input|output), and record ID required" "false" "{}" \
          "ark tasks documents url <id> <input|output> <record-id>"
        exit 2
      }
      if [[ "$kind" != "input" && "$kind" != "output" ]]; then
        err_json "bad_argument" "kind must be 'input' or 'output', got: ${kind}" "false" "{}" ""; exit 2
      fi

      [[ "$DRY_RUN" == "true" ]] && { dry_run_response "GET" "/api/tasks/${id}/documents/${kind}/${record_id}/url" ""; return; }

      http_request "GET" "/api/tasks/${id}/documents/${kind}/${record_id}/url"
      [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

      local data; data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')

      if [[ "${ARK_FORMAT:-json}" == "human" || "$HUMAN_OUTPUT" == "true" ]]; then
        printf '%s' "$data" | jq -r '.url'
        return
      fi
      ok_response "$data" "{}" "{}"
      ;;
    *) err_json "bad_argument" "Unknown documents subcommand: ${sub}. Use: url" "false" "{}" "ark tasks documents url <id> <input|output> <record-id>"; exit 2 ;;
  esac
}

