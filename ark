# ─── main ──────────────────────────────────────────────────────────────────────
main() {
  check_deps
  [[ $# -eq 0 ]] && usage 2

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --human)   HUMAN_OUTPUT=true; shift ;;
      --dry-run) DRY_RUN=true; shift ;;
      --)        shift; break ;;
      *)         break ;;
    esac
  done

  local cmd="${1:-}"; shift || true
  case "$cmd" in
    auth)   cmd_auth "$@" ;;
    config) cmd_config "$@" ;;
    tasks)
      local sub="${1:-}"; shift || true
      case "$sub" in
        list)     cmd_tasks_list "$@" ;;
        stats)    cmd_tasks_stats "$@" ;;
        find)     cmd_tasks_find "$@" ;;
        get)      cmd_tasks_get "$@" ;;
        create)   cmd_tasks_create "$@" ;;
        update)   cmd_tasks_update "$@" ;;
        context)      cmd_tasks_context "$@" ;;
        context-set)  cmd_tasks_context_set "$@" ;;
        status)       cmd_tasks_status "$@" ;;
        claim)      cmd_tasks_claim "$@" ;;
        claim-next) cmd_tasks_claim_next "$@" ;;
        ask-review) cmd_tasks_ask_review "$@" ;;
        complete) cmd_tasks_complete "$@" ;;
        block)    cmd_tasks_block "$@" ;;
        events)   cmd_tasks_events "$@" ;;
        delete)   cmd_tasks_delete "$@" ;;
        ingest-dir)    cmd_tasks_ingest_dir "$@" ;;
        release-batch) cmd_tasks_release_batch "$@" ;;
        inputs)
          local sub2="${1:-}"; shift || true
          case "$sub2" in
            list)   cmd_tasks_inputs_list "$@" ;;
            add)    cmd_tasks_inputs_add "$@" ;;
            upload) cmd_tasks_inputs_upload "$@" ;;
            download) cmd_tasks_inputs_download "$@" ;;
            remove) cmd_tasks_inputs_remove "$@" ;;
            ocr)    cmd_tasks_inputs_ocr "$@" ;;
            *) err_json "bad_argument" "Unknown inputs subcommand: ${sub2}" "false" "{}" ""; exit 2 ;;
          esac ;;
        comments)
          local sub2="${1:-}"; shift || true
          case "$sub2" in
            list)   cmd_tasks_comments_list "$@" ;;
            post)   cmd_tasks_comments_post "$@" ;;
            edit)   cmd_tasks_comments_edit "$@" ;;
            delete) cmd_tasks_comments_delete "$@" ;;
            *) err_json "bad_argument" "Unknown comments subcommand: ${sub2}" "false" "{}" ""; exit 2 ;;
          esac ;;
        outputs)
          local sub2="${1:-}"; shift || true
          case "$sub2" in
            list)   cmd_tasks_outputs_list "$@" ;;
            submit) cmd_tasks_outputs_submit "$@" ;;
            upload) cmd_tasks_outputs_upload "$@" ;;
            download) cmd_tasks_outputs_download "$@" ;;
            get)    cmd_tasks_outputs_get "$@" ;;
            *) err_json "bad_argument" "Unknown outputs subcommand: ${sub2}" "false" "{}" ""; exit 2 ;;
          esac ;;
        documents) cmd_tasks_documents_url "$@" ;;
        *) err_json "bad_argument" "Unknown tasks subcommand: ${sub}" "false" "{}" "ark help"; exit 2 ;;
      esac ;;
    batches)
      local sub="${1:-}"; shift || true
      case "$sub" in
        status) cmd_batches_status "$@" ;;
        *) err_json "bad_argument" "Unknown batches subcommand: ${sub}" "false" "{}" "ark batches status <batch-id>"; exit 2 ;;
      esac ;;
    reps)
      local sub="${1:-}"; shift || true
      case "$sub" in
        prestadores)  cmd_reps_prestadores "$@" ;;
        servicios)    cmd_reps_servicios "$@" ;;
        habilitacion) cmd_reps_habilitacion "$@" ;;
        *) err_json "bad_argument" "Unknown reps subcommand: ${sub}" "false" "{}" "ark reps prestadores|servicios|habilitacion"; exit 2 ;;
      esac ;;
    knowledge)
      local sub="${1:-}"; shift || true
      case "$sub" in
        files)
          local sub2="${1:-}"; shift || true
          case "$sub2" in
            list) cmd_knowledge_files_list "$@" ;;
            url)  cmd_knowledge_files_url "$@" ;;
            *) err_json "bad_argument" "Unknown files subcommand: ${sub2}" "false" "{}" "ark knowledge files list|url"; exit 2 ;;
          esac ;;
        upload) cmd_knowledge_upload "$@" ;;
        *) err_json "bad_argument" "Unknown knowledge subcommand: ${sub}" "false" "{}" "ark knowledge files|upload"; exit 2 ;;
      esac ;;
    learnings)
      local sub="${1:-}"; shift || true
      case "$sub" in
        files)
          local sub2="${1:-}"; shift || true
          case "$sub2" in
            list) cmd_learnings_files_list "$@" ;;
            url)  cmd_learnings_files_url "$@" ;;
            *) err_json "bad_argument" "Unknown files subcommand: ${sub2}" "false" "{}" "ark learnings files list|url"; exit 2 ;;
          esac ;;
        upload) cmd_learnings_upload "$@" ;;
        *) err_json "bad_argument" "Unknown learnings subcommand: ${sub}" "false" "{}" "ark learnings files|upload"; exit 2 ;;
      esac ;;
    agents)
      local sub="${1:-}"; shift || true
      case "$sub" in
        status)    cmd_agents_status "$@" ;;
        heartbeat) cmd_agents_heartbeat "$@" ;;
        *) err_json "bad_argument" "Unknown agents subcommand: ${sub}" "false" "{}" "ark agents status|heartbeat"; exit 2 ;;
      esac ;;
    audit)    cmd_audit "$@" ;;
    skills)   cmd_skills ;;
    schema)   cmd_schema ;;
    check)    cmd_check "$@" ;;
    gen-uuid) gen_uuid ;;
    version)  cmd_version ;;
    update)   cmd_update "$@" ;;
    help|--help|-h) usage 0 ;;
    *) err_json "bad_argument" "Unknown command: ${cmd}" "false" "{}" "ark help"; exit 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
