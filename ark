  http_request "GET" "/api/learnings/knowledge/files/url?path=${encoded_path}&name=${encoded_name}"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local signed_url expires_at storage_path
  signed_url=$(printf '%s' "$HTTP_BODY" | jq -r '.data.url // empty')
  expires_at=$(printf '%s' "$HTTP_BODY" | jq -r '.data.expires_at // empty')
  storage_path=$(printf '%s' "$HTTP_BODY" | jq -r '.data.path // empty')

  [[ -z "$signed_url" ]] && { err_json "storage_error" "No signed URL returned for ${path}/${name}" "false" "{}" ""; exit 1; }

  local dl_exit=0
  set +e
  curl --silent --show-error --location --output "$output_path" "$signed_url"
  dl_exit=$?
  set -e

  if [[ $dl_exit -ne 0 ]]; then
    err_json "network_error" "Download failed (curl exit ${dl_exit})" "true" "{}" ""
    exit 1
  fi

  local size_bytes; size_bytes=$(file_size_bytes "$output_path" 2>/dev/null || echo 0)
  local local_path; local_path=$(abs_path "$output_path")

  if [[ "${ARK_FORMAT:-json}" == "human" || "$HUMAN_OUTPUT" == "true" ]]; then
    printf 'Downloaded: %s (%s bytes)\n' "$local_path" "$size_bytes"
    return
  fi

  ok_response "$(jq -n \
    --arg url "$signed_url" --arg exp "$expires_at" \
    --arg sp "$storage_path" --arg lp "$local_path" --arg sz "$size_bytes" \
    '{url:$url,expires_at:$exp,path:$sp,local_path:$lp,size_bytes:$sz}')" "{}" "{}"
}

# ─── learnings upload ─────────────────────────────────────────────────────────
cmd_learnings_upload() {
  local filename="" size_bytes="" mime_type="" learning_type=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --filename=*)  filename="${1#--filename=}" ;;
      --filename)    shift; filename="$1" ;;
      --size=*)      size_bytes="${1#--size=}" ;;
      --size)        shift; size_bytes="$1" ;;
      --mime=*)      mime_type="${1#--mime=}" ;;
      --mime)        shift; mime_type="$1" ;;
      --type=*)      learning_type="${1#--type=}" ;;
      --type)        shift; learning_type="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" "ark learnings upload --filename=<name> --size=<bytes> --mime=<type> --type=operacional|negocio"; exit 2 ;;
    esac; shift || true
  done

  [[ -z "$filename" ]] && { err_json "bad_argument" "--filename is required" "false" "{}" "ark learnings upload --filename=<name> --size=<bytes> --mime=<type> --type=operacional|negocio"; exit 2; }
  [[ -z "$size_bytes" ]] && { err_json "bad_argument" "--size is required (bytes)" "false" "{}" ""; exit 2; }
  [[ -z "$mime_type" ]] && { err_json "bad_argument" "--mime is required" "false" "{}" ""; exit 2; }
  [[ -z "$learning_type" ]] && { err_json "bad_argument" "--type is required (operacional|negocio)" "false" "{}" ""; exit 2; }

  local body
  body=$(jq -n \
    --arg fn "$filename" --argjson sz "$size_bytes" \
    --arg mt "$mime_type" --arg lt "$learning_type" \
    '{filename:$fn,size_bytes:$sz,mime_type:$mt,type:$lt}')

  if [[ "$DRY_RUN" == "true" ]]; then
    dry_run_response "POST" "/api/learnings/knowledge/upload" "$body"
    return
  fi

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"
  http_request "POST" "/api/learnings/knowledge/upload" "$body" "$ikey"
  [[ "$HTTP_STATUS" == "200" || "$HTTP_STATUS" == "201" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data; data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')
  ok_response "$data" "{}" "{}"
}

# ─── agents status ────────────────────────────────────────────────────────────
cmd_agents_status() {
  [[ "$DRY_RUN" == "true" ]] && { dry_run_response "GET" "/api/agents/status"; return; }

  http_request "GET" "/api/agents/status"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data; data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')

  if [[ "${ARK_FORMAT:-json}" == "human" || "$HUMAN_OUTPUT" == "true" ]]; then
    printf '%s' "$data" | jq -r '
      if type == "array" then
        .[] | "[\(.agent_id // .id // "?")] status=\(.status // "?") last_heartbeat=\(.last_heartbeat_at // "never") loop=\(.loop_running // false)"
      elif type == "object" then
        "status=\(.status // "?") last_claimed=\(.last_claimed_at // "never") last_heartbeat=\(.last_heartbeat_at // "never") loop=\(.loop_running // false)"
      else . end'
    return
  fi
  ok_response "$data" "{}" "{}"
}

# ─── agents heartbeat ────────────────────────────────────────────────────────
cmd_agents_heartbeat() {
  local agent_id="" metadata=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent-id=*) agent_id="${1#--agent-id=}" ;;
      --agent-id)   shift; agent_id="$1" ;;
      --metadata=*) metadata="${1#--metadata=}" ;;
      --metadata)   shift; metadata="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" "ark agents heartbeat --agent-id=<id> [--metadata=<json>]"; exit 2 ;;
    esac; shift || true
  done

  [[ -z "$agent_id" ]] && { err_json "bad_argument" "--agent-id is required" "false" "{}" "ark agents heartbeat --agent-id=<id> [--metadata=<json>]"; exit 2; }

  local body
  if [[ -n "$metadata" ]]; then
    body=$(jq -n --arg id "$agent_id" --argjson meta "$metadata" '{agent_id:$id,metadata:$meta}')
  else
    body=$(jq -n --arg id "$agent_id" '{agent_id:$id}')
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    dry_run_response "POST" "/api/agents/heartbeat" "$body"
    return
  fi

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"
  http_request "POST" "/api/agents/heartbeat" "$body" "$ikey"
  [[ "$HTTP_STATUS" == "200" || "$HTTP_STATUS" == "201" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data; data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')
  ok_response "$data" "{}" "{}"
}

# ─── audit ─────────────────────────────────────────────────────────────────────
cmd_audit() {
  local operacion="${1:-}"; shift || true
  [[ -z "$operacion" ]] && {
    err_json "bad_argument" "Usage: ark audit <operacion> [arg]" "false" "{}" "ark audit <operacion> <arg>"
    exit 2
  }

  local ark_dir share_dir scripts_dir
  ark_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  share_dir="${ARK_SHARE_DIR:-${ARK_INSTALL_SHARE_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/tasks-ark-cli}}"
  scripts_dir="${ARK_SCRIPTS_DIR:-${share_dir}/scripts}"
  local script_path="${scripts_dir}/${operacion}.ts"

  # Source checkouts and manual installs can still keep scripts beside ark.
  # An explicit ARK_SCRIPTS_DIR remains authoritative.
  if [[ ! -f "$script_path" && -z "${ARK_SCRIPTS_DIR:-}" && -f "${ark_dir}/scripts/${operacion}.ts" ]]; then
    scripts_dir="${ark_dir}/scripts"
    script_path="${scripts_dir}/${operacion}.ts"
  fi

  if [[ ! -f "$script_path" ]]; then
    local available_ops=()
    local f
    for f in "${scripts_dir}"/*.ts; do
      [[ -f "$f" ]] && available_ops+=("$(basename "$f" .ts)")
    done
    local avail_json
    if [[ ${#available_ops[@]} -gt 0 ]]; then
      avail_json=$(printf '%s\n' "${available_ops[@]}" | jq -R '.' | jq -s '.')
    else
      avail_json='[]'
    fi
    local avail_hint
    if [[ ${#available_ops[@]} -eq 0 ]]; then
      avail_hint="No operations available in ${scripts_dir}"
    else
      avail_hint="Available: ${available_ops[*]}"
    fi
    err_json "bad_argument" "Unknown audit operation: ${operacion}" "false" \
      "{\"available_operations\":${avail_json}}" \
      "$avail_hint"
    exit 2
  fi

  if ! command -v npx &>/dev/null; then
    err_json "missing_dependency" "npx not found. Required to run audit scripts." "false" "{}" "Install Node.js: https://nodejs.org"
    exit 1
  fi

  local exit_code=0
  local stderr_file; stderr_file=$(mktemp)

  set +e
  npx tsx "$script_path" "$@" 2>"$stderr_file"
  exit_code=$?
  set -e

  if [[ $exit_code -ne 0 ]]; then
    cat "$stderr_file" >&2
    rm -f "$stderr_file"
    exit "$exit_code"
  fi

  rm -f "$stderr_file"
}

