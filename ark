# ─── tasks create ──────────────────────────────────────────────────────────────
cmd_tasks_create() {
  local title="" desc="" priority="" deadline="" ctx="" status="" task_type=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title=*)       title="${1#--title=}" ;;
      --title)         shift; title="$1" ;;
      --description=*) desc="${1#--description=}" ;;
      --description)   shift; desc="$1" ;;
      --priority=*)    priority="${1#--priority=}" ;;
      --priority)      shift; priority="$1" ;;
      --deadline=*)    deadline="${1#--deadline=}" ;;
      --deadline)      shift; deadline="$1" ;;
      --context=*)     ctx="${1#--context=}" ;;
      --context)       shift; ctx="$1" ;;
      --status=*)      status="${1#--status=}" ;;
      --status)        shift; status="$1" ;;
      --type=*)        task_type="${1#--type=}" ;;
      --type)          shift; task_type="$1" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done
  [[ -z "$title" ]] && { err_json "bad_argument" "--title is required" "false" "{}" "ark tasks create --title \"<title>\""; exit 2; }

  local body
  body=$(jq -n \
    --arg title "$title" --arg desc "$desc" --arg priority "$priority" \
    --arg deadline "$deadline" --arg status "$status" --arg ttype "$task_type" \
    '{title:$title}
     + (if $desc != "" then {description:$desc} else {} end)
     + (if $priority != "" then {priority:$priority} else {} end)
     + (if $deadline != "" then {deadline_at:$deadline} else {} end)
     + (if $status != "" then {status:$status} else {} end)
     + (if $ttype != "" then {task_type:$ttype} else {} end)')

  if [[ -n "$ctx" ]]; then
    printf '%s' "$ctx" | jq -e '.' &>/dev/null 2>&1 || { err_json "bad_argument" "--context must be valid JSON" "false" "{}" ""; exit 2; }
    body=$(printf '%s' "$ctx" | jq -n --argjson base "$body" 'input as $c | $base + {context:$c}')
  fi

  [[ "$DRY_RUN" == "true" ]] && { dry_run_response "POST" "/api/tasks" "$body"; return; }

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"
  http_request "POST" "/api/tasks" "$body" "$ikey"
  [[ "$HTTP_STATUS" == "200" || "$HTTP_STATUS" == "201" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data links cmds task_id
  data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')
  links=$(printf '%s' "$HTTP_BODY" | jq -c '._links // {}')
  task_id=$(printf '%s' "$data" | jq -r '.id // ""')
  cmds=$(next_cmds "$task_id" "$links")
  ok_response "$data" "$links" "$cmds"
}

