# ─── tasks context ─────────────────────────────────────────────────────────────
cmd_tasks_context() {
  local id="${1:-}"; shift || true
  [[ -z "$id" ]] && { err_json "bad_argument" "Task ID required" "false" "{}" "ark tasks context <id> --data '<json>'"; exit 2; }

  local ctx="" clear_ctx="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data=*)  ctx="${1#--data=}" ;;
      --data)    shift; ctx="$1" ;;
      --clear)   clear_ctx="true" ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" ""; exit 2 ;;
    esac; shift || true
  done

  if [[ "$clear_ctx" == "true" && -n "$ctx" ]]; then
    err_json "bad_argument" "--data and --clear are mutually exclusive" "false" "{}" ""; exit 2
  fi
  if [[ "$clear_ctx" == "false" && -z "$ctx" ]]; then
    err_json "bad_argument" "--data or --clear is required" "false" "{}" "ark tasks context ${id} --data '<json>' | --clear"; exit 2
  fi

  local body
  if [[ "$clear_ctx" == "true" ]]; then
    body=$(jq -n '{context:null}')
  else
    printf '%s' "$ctx" | jq -e '.' &>/dev/null 2>&1 \
      || { err_json "bad_argument" "--data must be valid JSON" "false" "{}" ""; exit 2; }
    body=$(printf '%s' "$ctx" | jq -n 'input as $c | {context:$c}')
  fi

  [[ "$DRY_RUN" == "true" ]] && { dry_run_response "PATCH" "/api/tasks/${id}" "$body"; return; }

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"
  http_request "PATCH" "/api/tasks/${id}" "$body" "$ikey"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data links cmds
  data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')
  links=$(printf '%s' "$HTTP_BODY" | jq -c '._links // {}')
  cmds=$(next_cmds "$id" "$links")
  ok_response "$data" "$links" "$cmds"
}

# ─── tasks context-set ─────────────────────────────────────────────────────────
cmd_tasks_context_set() {
  local id="${1:-}"; shift || true
  [[ -z "$id" ]] && { err_json "bad_argument" "Task ID required" "false" "{}" "ark tasks context-set <id> --set key=value"; exit 2; }

  local -a pairs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --set=*) pairs+=("${1#--set=}") ;;
      --set)   shift; pairs+=("$1") ;;
      *) err_json "bad_argument" "Unknown: $1" "false" "{}" "ark tasks context-set <id> --set key=value"; exit 2 ;;
    esac; shift || true
  done

  [[ ${#pairs[@]} -eq 0 ]] && { err_json "bad_argument" "At least one --set key=value is required" "false" "{}" "ark tasks context-set <id> --set key=value"; exit 2; }

  local ikey="${ARK_IDEMPOTENCY_KEY:-$(gen_uuid)}"

  [[ "$DRY_RUN" == "true" ]] && {
    local preview="{}"
    for pair in "${pairs[@]}"; do
      local k="${pair%%=*}" v="${pair#*=}"
      if [[ "$v" == "true" || "$v" == "false" ]]; then
        preview=$(printf '%s' "$preview" | jq --arg k "$k" --argjson v "$v" '. + {($k): $v}')
      elif [[ "$v" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
        preview=$(printf '%s' "$preview" | jq --arg k "$k" --argjson v "$v" '. + {($k): $v}')
      else
        preview=$(printf '%s' "$preview" | jq --arg k "$k" --arg v "$v" '. + {($k): $v}')
      fi
    done
    dry_run_response "PATCH" "/api/tasks/${id}" "{\"context_merge\":${preview}}"
    return
  }

  # GET current context
  http_request "GET" "/api/tasks/${id}" "" ""
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"
  local current_ctx
  current_ctx=$(printf '%s' "$HTTP_BODY" | jq -c '.data.context // {}')

  # Merge pairs into current context
  local merged="$current_ctx"
  for pair in "${pairs[@]}"; do
    local k="${pair%%=*}" v="${pair#*=}"
    if [[ "$v" == "true" || "$v" == "false" ]]; then
      merged=$(printf '%s' "$merged" | jq --arg k "$k" --argjson v "$v" '. + {($k): $v}')
    elif [[ "$v" =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
      merged=$(printf '%s' "$merged" | jq --arg k "$k" --argjson v "$v" '. + {($k): $v}')
    else
      merged=$(printf '%s' "$merged" | jq --arg k "$k" --arg v "$v" '. + {($k): $v}')
    fi
  done

  local body; body=$(printf '%s' "$merged" | jq -n 'input as $c | {context:$c}')
  export ARK_IDEMPOTENCY_KEY="$ikey"
  http_request "PATCH" "/api/tasks/${id}" "$body" "$ikey"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"

  local data links cmds
  data=$(printf '%s' "$HTTP_BODY" | jq -c '.data // {}')
  links=$(printf '%s' "$HTTP_BODY" | jq -c '._links // {}')
  cmds=$(next_cmds "$id" "$links")
  ok_response "$data" "$links" "$cmds"
}

