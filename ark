              local_path:           "/tmp/devoluciones_<nit>_<fecha>.xlsx",
              total_items_glosados: "<number>",
              email_destino:        "<email>",
              prestador_nombre:     "<nombre>"
            }
          },
          "send-preventiva-mail": {
            usage:        "ark audit send-preventiva-mail <batch_task_id>",
            description:  "Genera el Excel consolidado de facturas radicadas preventiva y lo sube a Supabase Storage. El agente es responsable de enviar el correo vía GOG después.",
            env_required: ["SUPABASE_URL","SUPABASE_SERVICE_KEY"],
            env_optional: ["SUPABASE_STORAGE_BUCKET (default: task-outputs)","ARK_API_URL","ARK_API_KEY"],
            exit_codes: {
              "0": "Excel generado y subido — stdout incluye storage_path, local_path, email_destino, pagador_nombre, total_facturas",
              "1": "Error recuperable (API, storage) — marcar tarea como blocked",
              "2": "Argumento inválido o tarea no encontrada — no reintentar"
            },
            stdout_on_success: {
              ok:             true,
              batch_task_id:  "<uuid>",
              excel_filename: "Radicacion_<nit>_<fecha>.xlsx",
              storage_path:   "storage://task-outputs/preventiva-mails/<filename>",
              local_path:     "/tmp/Radicacion_<nit>_<fecha>.xlsx",
              total_facturas: "<number>",
              email_destino:  "<email>",
              pagador_nombre: "<nombre>"
            }
          }
        }
      }
    }
  }'
}

# ─── schema ────────────────────────────────────────────────────────────────────
cmd_schema() {
  http_request "GET" "/api/openapi.json"
  [[ "$HTTP_STATUS" == "200" ]] || handle_http_error "$HTTP_STATUS" "$HTTP_BODY"
  echo "$HTTP_BODY"
}

# ─── check ─────────────────────────────────────────────────────────────────────
cmd_check() {
  local check_url="${ARK_CHECK_URL:-${ARK_DEFAULT_API_URL}/api/openapi.json}"

  local spec
  spec=$(curl -fsSL "$check_url") || { err_json "network_error" "Failed to fetch spec from $check_url" "true" "{}" ""; exit 1; }

  local api_fields_json
  api_fields_json=$(printf '%s' "$spec" | jq -c '[.components.schemas.Task.properties | keys[]]')

  local missing_json extra_json
  missing_json=$(printf '%s' "$api_fields_json" | jq -c --arg known "$KNOWN_TASK_FIELDS" \
    '[.[] | select(. as $f | ($known | split(" ") | index($f)) == null)]')
  extra_json=$(jq -cn --arg known "$KNOWN_TASK_FIELDS" --argjson api "$api_fields_json" \
    '($known | split(" ")) | map(select(. as $f | ($api | index($f)) == null))')

  local missing_count
  missing_count=$(printf '%s' "$missing_json" | jq 'length')

  local status="up_to_date"
  [[ "$missing_count" -gt 0 ]] && status="outdated"

  local cli_fields_json
  cli_fields_json=$(jq -cn --arg known "$KNOWN_TASK_FIELDS" '$known | split(" ")')

  jq -n \
    --arg v "$ARK_VERSION" \
    --arg status "$status" \
    --arg url "$check_url" \
    --argjson api_fields "$api_fields_json" \
    --argjson cli_fields "$cli_fields_json" \
    --argjson missing "$missing_json" \
    --argjson extra "$extra_json" \
    '{ok:true,cli_version:$v,data:{status:$status,spec_url:$url,api_fields:$api_fields,cli_fields:$cli_fields,missing_in_cli:$missing,extra_in_cli:$extra}}'

  [[ "$missing_count" -gt 0 ]] && exit 1
  exit 0
}

# ─── version ───────────────────────────────────────────────────────────────────
cmd_version() {
  jq -n --arg v "$ARK_VERSION" '{ok:true,cli_version:$v,data:{name:"tasks-ark",version:$v}}'
}

# ─── update ────────────────────────────────────────────────────────────────────
cmd_update() {
  local here updater
  here="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" 2>/dev/null && pwd || dirname "$0")"
  export ARK_SHARE_DIR="${ARK_SHARE_DIR:-${ARK_INSTALL_SHARE_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/tasks-ark-cli}}"
  updater="${here}/skill.sh"
  if [[ -x "$updater" ]]; then
    exec "$updater" "$@"
  fi
  exec bash -c 'curl -fsSL "https://raw.githubusercontent.com/${ARK_UPDATE_REPO:-arkangelai/ark-cli}/main/skill.sh" | bash -s -- "$@"' _ "$@"
}

