#!/usr/bin/env bash
set -euo pipefail

output_file=""
header_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output)
      output_file="$2"
      shift 2
      ;;
    --dump-header)
      header_file="$2"
      shift 2
      ;;
    --write-out|-X|-H|--data)
      shift 2
      ;;
    --silent)
      shift
      ;;
    *)
      shift
      ;;
  esac
done

printf '%s' "${MOCK_CURL_BODY:?MOCK_CURL_BODY is required}" > "$output_file"
: > "$header_file"
printf '%s' "${MOCK_CURL_STATUS:-200}"
